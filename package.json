{
  "name": "turkiye-iban-repo",
  "version": "0.1.0",
  "private": true,
  "description": "Official-source-first Turkish IBAN provider data and packages.",
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "packages/typescript"
  ],
  "scripts": {
    "data:update": "python scripts/generate-data.py",
    "data:check-remote": "python scripts/check-sources.py",
    "generate:data": "npm run data:update",
    "validate:data": "python scripts/validate-data.py",
    "check:privacy": "python scripts/check-privacy.py",
    "test:tools": "python -m unittest discover -s tools -p \"test_*.py\"",
    "prepare:release": "python scripts/prepare-release.py",
    "build": "npm -w packages/typescript run build",
    "test": "npm run validate:data && npm run check:privacy && npm -w packages/typescript test && npm run test:tools"
  }
}
