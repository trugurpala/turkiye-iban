{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Turkish IBAN Data Source Manifest",
  "type": "object",
  "required": ["$schema", "generatedAt", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "url", "retrievedAt", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "retrievedAt": { "type": "string", "format": "date" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
